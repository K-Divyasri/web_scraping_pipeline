# Copy this to ".env" and fill in real values. ".env" is git-ignored so secrets
# never get committed. In GitHub Actions these come from repo Secrets instead.

# This demo uses local SQLite and needs no secret. When you graduate to cloud
# Postgres (e.g. Neon), put the connection string here and have store.py read it:
# DB_URL=postgresql://user:password@host.neon.tech:5432/dbname

# A contact to advertise in the scraper's User-Agent (be reachable).
SCRAPER_CONTACT=you@example.com
